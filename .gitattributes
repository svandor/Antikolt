# Normalise line endings so a Windows checkout and a Linux CI see the same bytes.
* text=auto eol=lf

# Windows-only helpers keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary artefacts are never converted.
*.png binary
*.jpg binary
*.webp binary
*.odt binary
*.gif binary
*.ico binary
*.zip binary
*.exe binary
*.dll binary

# Generated or vendored content: no diff noise.
Cargo.lock merge=binary
