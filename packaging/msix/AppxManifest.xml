<!--
  MSIX manifest for the Store channel (ADR-040).

  This package is the *Store* artefact: the Microsoft Store re-signs it after certification, so no
  certificate of ours is involved. It contains the same three processes as the portable folder - the shell
  starts the engine host and the core service next to itself, which is why the manifest declares
  `runFullTrust` and the payload keeps the flat layout (antikolt-shell.exe beside its two helpers, beside
  home\).

  Identity: the Publisher must match the certificate that signs the package for local testing, and it must be
  the Store-assigned identity for a Store submission (Partner Center gives the exact values). Everything in
  the Identity element is a placeholder until then - a mismatch is rejected by makeappx/Add-AppxPackage.
-->
<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
    IgnorableNamespaces="uap rescap">

  <Identity
      Name="AntikoltProject.Antikolt"
      Publisher="CN=Antikolt test (NOT TRUSTED)"
      Version="0.1.0.0"
      ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Antikolt</DisplayName>
    <PublisherDisplayName>Antikolt Project</PublisherDisplayName>
    <Logo>assets\StoreLogo.png</Logo>
    <Description>Memóriatakarékos, kártya-alapú böngésző: egyszerre egy élő kártya, a többi lemezen.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="hu-HU" />
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <!--
      Full trust, because this is a packaged Win32 application: Qt and CEF need to load their own DLLs, spawn
      the engine host and write to the user's profile. A restricted (app container) package could not run a
      browser engine.
    -->
    <Application Id="Antikolt" Executable="antikolt-shell.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
          DisplayName="Antikolt"
          Description="Memóriatakarékos, kártya-alapú böngésző"
          BackgroundColor="transparent"
          Square150x150Logo="assets\Square150x150Logo.png"
          Square44x44Logo="assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="assets\SplashScreen.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- The whole point of a browser: the network. -->
    <Capability Name="internetClient" />
    <!-- Writing the library and the profile, and starting the two helper processes next to the exe. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
